#!/usr/bin/env python3
"""ShipCheck CLI.

The deterministic half of ShipCheck, runnable without Claude Code — in CI, from
a Makefile, or from any other agent. Same scanner, same corpus, same citations.

The judgment half (store-listing metadata, paywall disclosure, 4.2, category
rules) needs a model reading current guideline text, and lives in the Claude
Code plugin where the user's own Claude does that work.

    shipcheck scan [path]        terminal report; exits 1 on a critical finding
    shipcheck report [path]      write shipcheck-report.md
    shipcheck init [path]        drop a shipcheck.metadata.md template
    shipcheck refresh            re-fetch policy corpus and diff
    shipcheck corpus             show what the cached corpus contains

    shipcheck gate check <artifact>    THE SUBMISSION GATE -- requires evidence
    shipcheck gate inspect <artifact>  what the built binary actually says
    shipcheck gate launch <artifact>   earn the launch proof on a simulator
    shipcheck gate stress <artifact>   the abuse patterns that found real bugs
    shipcheck gate attest <artifact>   record what a tool cannot check

`scan` reads config and source: useful, and not sufficient. `gate` reads the
BUILT ARTIFACT and requires proof that it was run. Nothing is submitted until
`gate check` passes -- see scripts/shipgate.py for why, at length.

Standard library only. Python 3.9+.
"""
import argparse
import json
import os
import subprocess
import shutil
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(HERE)
SCRIPTS = os.path.join(ROOT, "scripts")
sys.path.insert(0, SCRIPTS)

import report as report_mod                          # noqa: E402
from scan import Scan                                # noqa: E402

USE_COLOR = sys.stdout.isatty() and os.environ.get("NO_COLOR") is None


def c(code, text):
    return "\033[%sm%s\033[0m" % (code, text) if USE_COLOR else text


BADGE = {
    "critical": lambda: c("1;31", "CRITICAL"),
    "high":     lambda: c("31", "HIGH    "),
    "medium":   lambda: c("33", "MEDIUM  "),
    "low":      lambda: c("2", "LOW     "),
    "info":     lambda: c("2", "INFO    "),
}
ORDER = ["critical", "high", "medium", "low", "info"]


def wrap(text, width, indent):
    out, line = [], ""
    for word in str(text).split():
        if len(line) + len(word) + 1 > width:
            out.append(line)
            line = word
        else:
            line = (line + " " + word).strip()
    if line:
        out.append(line)
    return ("\n" + " " * indent).join(out)


def run_scan(path, platform, offline):
    return Scan(path, platform, offline).run()


def cmd_scan(args):
    data = run_scan(args.path, args.platform, args.offline)
    findings = report_mod.rank(data["findings"])
    facts = data["facts"]

    if args.json:
        counts = {s: sum(1 for f in findings if f["severity"] == s) for s in ORDER}
        out = dict(facts=facts, findings=findings, gaps=data["gaps"],
                   score=report_mod.score(findings), counts=counts)
        print(json.dumps(out, indent=2, ensure_ascii=False, default=str))
        return 1 if counts["critical"] else 0

    width = min(shutil.get_terminal_size((100, 24)).columns, 100)

    print()
    print("  %s  %s%s" % (c("1", "shipcheck"),
                          facts.get("app_name") or os.path.basename(
                              os.path.abspath(args.path)),
                          "  v%s" % facts["version"] if facts.get("version") else ""))
    cm = os.path.join(ROOT, "corpus", "manifest.json")
    if os.path.exists(cm):
        with open(cm, encoding="utf-8") as f:
            m = json.load(f)
        print("  %s" % c("2", "policy corpus: %d sources, fetched %s"
                         % (m.get("source_count", 0),
                            (m.get("generated_at") or "?")[:10])))
    print()

    if not findings:
        print("  %s  nothing blocking found" % c("1;32", "CLEAR"))
    score = report_mod.score(findings)

    shown = None
    for f in findings:
        sev = f.get("severity", "info")
        if sev != shown:
            shown = sev
            print()
        blocks = report_mod.blocks(f)
        head = "  %s  %s" % (BADGE.get(sev, BADGE["info"])(),
                             wrap(f["title"], width - 14, 12))
        print(head)
        tags = []
        if f.get("clause"):
            tags.append(f["clause"])
        if f.get("itms"):
            tags.append(f["itms"])
        tags.append(report_mod.BLOCK_LABEL[blocks])
        if f.get("confidence") and f["confidence"] != "high":
            tags.append("confidence: %s" % f["confidence"])
        print("            %s" % c("2", " · ".join(tags)))
        if f.get("evidence") and args.verbose:
            print("            %s" % c("2", wrap(f["evidence"], width - 14, 12)))
        if f.get("fix"):
            # keep the first two lines: the plist/gradle fixes put the actual
            # key on line two, so truncating at the newline loses the answer
            fix = " ".join(l.strip() for l in f["fix"].split("\n")[:2] if l.strip())
            print("            %s %s" % (c("2", "fix:"), wrap(fix, width - 18, 17)))

    counts = {s: sum(1 for f in findings if f["severity"] == s) for s in ORDER}
    print()
    print("  " + "─" * (width - 4))
    verdict = (c("1;31", "NOT READY") if counts["critical"]
               else c("1;33", "REVIEW") if counts["high"]
               else c("1;32", "LOOKS CLEAR"))
    breakdown = " · ".join("%d %s" % (counts[s], s) for s in ORDER if counts[s])
    print("  %s — risk %d/100%s" % (
        verdict, score, " · " + breakdown if breakdown else ""))

    upload = sum(1 for f in findings if report_mod.blocks(f) == "upload")
    meta = sum(1 for f in findings if report_mod.blocks(f) == "metadata")
    if upload:
        print("  %d block the upload." % upload)
    if meta:
        print("  %d are metadata only — fixable in App Store Connect, no new build."
              % meta)

    for g in data["gaps"]:
        print("  %s %s — %s" % (c("33", "not checked:"), g["what"],
                                wrap(g["why"], width - 20, 4)))

    if not facts.get("metadata_present"):
        print()
        print("  %s" % c("1", "Half of App Store rejections are store-listing "
                              "problems (guideline 2.3)."))
        print("  Those cannot be seen from code. Run %s to add the listing,"
              % c("1", "shipcheck init"))
        print("  then %s in Claude Code for the judgment checks."
              % c("1", "/shipcheck:scan"))
    print()
    return 1 if counts["critical"] else 0


def cmd_report(args):
    data = run_scan(args.path, args.platform, args.offline)
    out = args.out or os.path.join(args.path, "shipcheck-report.md")
    tmp = os.path.join(args.path, ".shipcheck")
    os.makedirs(tmp, exist_ok=True)
    fp = os.path.join(tmp, "findings.json")
    with open(fp, "w", encoding="utf-8") as f:
        json.dump(data, f, indent=2, default=str)
    subprocess.run([sys.executable, os.path.join(SCRIPTS, "report.py"),
                    "--findings", fp, "--out", out], check=True)
    return 0


def cmd_init(args):
    dest = os.path.join(args.path, "shipcheck.metadata.md")
    if os.path.exists(dest) and not args.force:
        print("shipcheck.metadata.md already exists (use --force to overwrite)")
        return 1
    shutil.copyfile(os.path.join(ROOT, "templates", "shipcheck.metadata.md"), dest)
    print("Wrote %s" % dest)
    print("Fill it in with what you will paste into App Store Connect, then "
          "re-run.")
    return 0


def cmd_gate(args):
    """The submission gate. Binary evidence, a launch proof, a stress pass."""
    import shipgate                                        # noqa: PLC0415

    sub = args.gate_cmd
    try:
        if sub == "inspect":
            art = shipgate.Artifact(args.artifact)
            try:
                facts = art.facts()
                exts = art.extensions()
                try:
                    linked = art.linked_system_frameworks()
                except shipgate.GateError:
                    linked = {}
                prov, prov_why = shipgate.scene_provenance(args.project, art)
            finally:
                art.cleanup()
            if args.json:
                print(json.dumps(dict(facts=facts,
                                      extensions=[n for n, _p in exts],
                                      linked_frameworks=sorted(linked),
                                      scene_provenance=prov,
                                      scene_provenance_detail=prov_why),
                                 indent=2, default=str))
                return 0
            print()
            print("  %s  %s" % (c("1", "gate inspect"),
                                os.path.basename(facts["app"])))
            print("  %s" % c("2", "read from the artifact, not from config"))
            print()
            rows = [
                ("bundle id", facts["bundle_id"]),
                ("version", "%s (%s)" % (facts["version"], facts["build"])),
                ("linked SDK", facts["linked_sdk"]),
                ("min OS", facts["minos"]),
                ("binary UUID", facts["binary_uuid"]),
                ("plist fingerprint", facts["fingerprint"]),
                ("scene manifest", "yes" if facts["scene_manifest"] else "no"),
                ("scene delegate", facts["scene_delegate"] or c("31", "NONE")),
                ("scene provenance", "%s — %s" % (prov, prov_why)),
                ("usage descriptions",
                 ", ".join(facts["usage_descriptions"]) or "(none)"),
                ("app privacy manifest",
                 "yes" if facts["app_privacy_manifest"] else c("31", "no")),
                ("sdk privacy manifests", facts["sdk_privacy_manifests"]),
                ("icon in bundle", facts["icon_detail"]),
                ("export compliance", facts["export_compliance"]),
                ("app extensions",
                 ", ".join(n for n, _p in exts) or "(none)"),
            ]
            for k, v in rows:
                print("  %-22s %s" % (k, wrap(v, 74, 25)))
            if facts["read_error"]:
                print("  %-22s %s" % ("read error",
                                      c("31", facts["read_error"])))
            print()
            return 0

        if sub == "launch":
            rc, _r = shipgate.do_launch(
                args.artifact, udid=args.udid, runtime=args.runtime,
                settle=args.settle, project_root=args.project)
            return rc

        if sub == "stress":
            if args.record:
                return shipgate.record_stress(
                    args.artifact, args.record, args.result, args.note,
                    args.by, project_root=args.project)
            if args.run:
                return shipgate.run_stress(
                    args.artifact, udid=args.udid, runtime=args.runtime,
                    project_root=args.project)
            print("The %d patterns, each of which caught a real defect in\n"
                  "this portfolio -- none of them visible to any scan:"
                  % len(shipgate.STRESS_PATTERNS))
            for k, title, why in shipgate.STRESS_PATTERNS:
                print("\n  %s  %s" % (c("1", k), title))
                print("      %s" % c("2", wrap(why, 72, 6)))
            print("\nDrive what can be driven:  gate stress <artifact> --run")
            print("Record the rest:           gate stress <artifact> "
                  "--record <pattern> --result pass|fail|n/a --note \"...\"")
            print("%s" % c("2", "n/a needs a reason: an unexplained n/a is how "
                                "a required check quietly becomes optional."))
            return 0

        if sub == "attest":
            if not args.item:
                print("Things this tool cannot check, and therefore requires "
                      "were done and recorded:")
                for k, title, why in (list(shipgate.ATTEST_ITEMS)
                                      + [shipgate.EXTENSION_ATTEST]):
                    print("\n  %s  %s" % (c("1", k), title))
                    print("      %s" % c("2", wrap(why, 72, 6)))
                print("\n  gate attest <artifact> --item <item> --by \"<name>\" "
                      "--note \"<what you did and saw>\"")
                return 0
            return shipgate.record_attest(
                args.artifact, args.item, args.result, args.note, args.by,
                project_root=args.project)

        # ---------------------------------------------------------- check
        res = shipgate.gate_check(args.artifact, args.project)
        if args.json:
            print(json.dumps(res, indent=2, default=str))
            return 1 if res["blocking"] else 0

        width = min(shutil.get_terminal_size((100, 24)).columns, 100)
        f = res["facts"]
        print()
        print("  %s  %s  %s" % (c("1", "shipcheck gate"),
                                os.path.basename(f["app"]),
                                c("2", "%s+%s" % (f["version"], f["build"]))))
        print("  %s" % c("2", "SDK %s · binary %s · %s"
                         % (f["linked_sdk"], (f["binary_uuid"] or "?")[:8],
                            f["fingerprint"])))
        print()
        ev = res["evidence"]
        label = {"exact": c("32", "proven (this binary)"),
                 "sibling": c("32", "proven (sibling build, keys agree)"),
                 "absent": c("31", "no evidence"),
                 "expired": c("31", "expired / wrong binary"),
                 "config": c("32", "tracked config"),
                 "tracked-plist": c("32", "tracked ios plist"),
                 "tracked-plugin": c("32", "tracked config plugin"),
                 "unexplained": c("1;31", "NOT REPRODUCIBLE"),
                 "unknown": c("33", "could not establish"),
                 "n/a": c("2", "not applicable")}
        for k in ("provenance", "launch", "stress", "attest"):
            print("  %-12s %s" % (k, label.get(ev[k], ev[k])))
        print()
        for fi in res["findings"]:
            sev = fi["severity"]
            print("  %s  %s" % (BADGE.get(sev, BADGE["info"])(),
                               wrap(fi["title"], width - 14, 12)))
            if fi.get("clause"):
                print("            %s" % c("2", fi["clause"]))
            if fi.get("evidence"):
                print("            %s" % c("2", wrap(fi["evidence"],
                                                     width - 14, 12)))
            if fi.get("fix") and args.verbose:
                print("            %s %s" % (c("2", "fix:"),
                                             wrap(fi["fix"], width - 18, 17)))
        print()
        print("  " + "─" * (width - 4))
        verdict = {"BLOCKED": c("1;31", "DO NOT SUBMIT"),
                   "REVIEW": c("1;33", "REVIEW"),
                   "CLEARED": c("1;32", "CLEARED TO SUBMIT")}[res["verdict"]]
        print("  %s — %d blocking, %d total"
              % (verdict, res["blocking"], len(res["findings"])))
        if res["verdict"] == "BLOCKED":
            print("  %s" % c("2", "Every blocking item is a missing piece of "
                                  "evidence or a measured defect. None of them "
                                  "can be cleared by editing a config file."))
        if not args.verbose:
            print("  %s" % c("2", "-v for the fix for each"))
        print()
        return 1 if res["blocking"] else 0

    except shipgate.GateError as e:
        print("gate could not evaluate: %s" % e, file=sys.stderr)
        # 3, not 1 and never 0: "I could not check" must not read as "it is
        # fine", and must be distinguishable from "I checked and it failed".
        return 3


def cmd_refresh(args):
    return subprocess.run(
        [sys.executable, os.path.join(SCRIPTS, "fetch_corpus.py"), "--diff"]).returncode


def cmd_corpus(args):
    with open(os.path.join(ROOT, "corpus", "manifest.json"), encoding="utf-8") as f:
        m = json.load(f)
    print("%d sources · %d chunks · %d failures · fetched %s"
          % (m["source_count"], sum(s["section_count"] for s in m["sources"]),
             m["failure_count"], m["generated_at"][:10]))
    for s in m["sources"]:
        flag = " (substituted)" if s.get("substituted_from") else ""
        print("  %-8s %-32s %5d chars  %3d sections%s"
              % (s["vendor"], s["id"][:32], s["chars"], s["section_count"], flag))
    return 0


def main():
    ap = argparse.ArgumentParser(prog="shipcheck",
                                 description=__doc__.split("\n")[2])
    sub = ap.add_subparsers(dest="cmd")

    def common(p):
        p.add_argument("path", nargs="?", default=".")
        p.add_argument("--platform", default="both",
                       choices=["ios", "android", "both"])
        p.add_argument("--offline", action="store_true",
                       help="skip outbound URL reachability checks")
        return p

    s = common(sub.add_parser("scan", help="terminal report"))
    s.add_argument("-v", "--verbose", action="store_true")
    s.add_argument("--json", action="store_true",
                   help="machine-readable output instead of the terminal report "
                        "(for CI or scripting); exit code is unchanged")
    s.set_defaults(fn=cmd_scan)

    r = common(sub.add_parser("report", help="write shipcheck-report.md"))
    r.add_argument("--out", default="")
    r.set_defaults(fn=cmd_report)

    i = sub.add_parser("init", help="add a shipcheck.metadata.md template")
    i.add_argument("path", nargs="?", default=".")
    i.add_argument("--force", action="store_true")
    i.set_defaults(fn=cmd_init)

    sub.add_parser("refresh", help="re-fetch policy corpus").set_defaults(fn=cmd_refresh)
    sub.add_parser("corpus", help="show cached corpus").set_defaults(fn=cmd_corpus)

    # ------------------------------------------------------------------ gate
    g = sub.add_parser("gate", help="the submission gate: binary evidence, "
                                    "a launch proof, a stress pass")
    gsub = g.add_subparsers(dest="gate_cmd")

    def gcommon(p, artifact=True):
        if artifact:
            p.add_argument("artifact",
                           help="a built .app, .ipa or .xcarchive -- the "
                                "artifact, not the project")
        p.add_argument("--project", default=".",
                       help="the git repo this artifact was built from; used "
                            "to check whether its safety is reproducible from "
                            "TRACKED config, and where receipts are written")
        p.add_argument("--json", action="store_true")
        p.add_argument("-v", "--verbose", action="store_true")
        return p

    gc = gcommon(gsub.add_parser(
        "check", help="the verdict; exit 1 if blocked, 3 if unevaluable"))
    gc.set_defaults(fn=cmd_gate, gate_cmd="check")

    gi = gcommon(gsub.add_parser(
        "inspect", help="what the built binary actually says"))
    gi.set_defaults(fn=cmd_gate, gate_cmd="inspect")

    gl = gcommon(gsub.add_parser(
        "launch", help="install and launch on a simulator, earn the receipt"))
    gl.add_argument("--udid", default=None)
    gl.add_argument("--runtime", default="iOS-26",
                    help="runtime substring to match (default iOS-26; build "
                         "for 26.5 from this machine, since an iOS 27 build "
                         "here crashes unless the app carries the scene fix)")
    gl.add_argument("--settle", type=int, default=10)
    gl.set_defaults(fn=cmd_gate, gate_cmd="launch")

    gs = gcommon(gsub.add_parser("stress", help="the abuse patterns"))
    gs.add_argument("--run", action="store_true",
                    help="drive the patterns a tool can honestly drive")
    gs.add_argument("--record", default=None, metavar="PATTERN")
    gs.add_argument("--result", default="pass",
                    choices=["pass", "fail", "n/a"])
    gs.add_argument("--note", default="")
    gs.add_argument("--by", default=None)
    gs.add_argument("--udid", default=None)
    gs.add_argument("--runtime", default="iOS-26")
    gs.set_defaults(fn=cmd_gate, gate_cmd="stress")

    ga = gcommon(gsub.add_parser("attest", help="record what a tool cannot do"))
    ga.add_argument("--item", default=None)
    ga.add_argument("--result", default="pass", choices=["pass", "fail"])
    ga.add_argument("--note", default="")
    ga.add_argument("--by", default=None)
    ga.set_defaults(fn=cmd_gate, gate_cmd="attest")

    args = ap.parse_args()
    if not getattr(args, "fn", None):
        ap.print_help()
        return 0
    return args.fn(args)


if __name__ == "__main__":
    sys.exit(main())
