  "usage_description_defaults": {
    "_comment": "Expo config plugins inject these templated strings. Apple rejects generic purpose strings under 5.1.1(i) because they do not explain the specific use.",
    "patterns": [
      "Allow $(PRODUCT_NAME) to access your camera",
      "Allow $(PRODUCT_NAME) to access your microphone",
      "Allow $(PRODUCT_NAME) to access your photos",
      "Allow $(PRODUCT_NAME) to save photos",
      "Allow $(PRODUCT_NAME) to use your location",
      "Allow $(PRODUCT_NAME) to access your contacts",
      "Allow $(PRODUCT_NAME) to access your calendar",
      "Allow $(PRODUCT_NAME) to use Face ID"
    ],
    "weak_regexes": [
      "(?i)^allow\\s+\\$\\(PRODUCT_NAME\\)",
      "(?i)^(we )?(need|require|use)s? (access to )?(your )?\\w+\\.?$",
      "(?i)^this app (needs|requires|uses)",
      "(?i)^(for|to) (better|improve|enhance)",
      "(?i)^\\s*$"
    ]
  },
  "android_foreground_service_types": {
    "_comment": "Android 14+ requires a declared foregroundServiceType and a matching FOREGROUND_SERVICE_* permission.",
    "map": {
      "location": "android.permission.FOREGROUND_SERVICE_LOCATION",
      "camera": "android.permission.FOREGROUND_SERVICE_CAMERA",
      "microphone": "android.permission.FOREGROUND_SERVICE_MICROPHONE",
      "health": "android.permission.FOREGROUND_SERVICE_HEALTH",
      "mediaPlayback": "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
      "dataSync": "android.permission.FOREGROUND_SERVICE_DATA_SYNC",
      "connectedDevice": "android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE",
      "remoteMessaging": "android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING",
      "shortService": null,
      "specialUse": "android.permission.FOREGROUND_SERVICE_SPECIAL_USE"
    }
  },
